# E-Job Vacancy - environment variables template
# Copy to .env and fill in real values. Never commit real secrets.

# ---- Backend ----
EJOB_SERVER_PORT=8080
EJOB_DB_URL=jdbc:mysql://localhost:3306/ejob_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
EJOB_DB_USERNAME=root
EJOB_DB_PASSWORD=change-me
EJOB_DDL_AUTO=update

# JWT: base64 of a random >=32-byte string, e.g.
#   openssl rand -base64 48
EJOB_JWT_SECRET=replace-with-a-long-random-base64-secret
EJOB_JWT_EXPIRATION_MS=86400000

# File storage directory for resumes / logos / profile pictures
EJOB_UPLOADS_DIR=./uploads

# CORS origins for web clients (comma separated), * for local development
EJOB_CORS_ORIGINS=*

# ---- Mobile (mobile/.env or --dart-define) ----
# Base URL of the backend REST API. On an Android emulator use 10.0.2.2 for host localhost.
EJOB_API_BASE_URL=http://10.0.2.2:8080
